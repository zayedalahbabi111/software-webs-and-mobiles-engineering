        <mxCell id="c18" value="Session: signed, expiring HttpOnly cookie containing the verified profile; Identity Gate checks signature and expiry on every board request.&#10;Durable domain data lives in Board Database, not process memory; refresh performs a new stored-state query. [R1, R5]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff2dd;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
