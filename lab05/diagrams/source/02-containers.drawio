        </mxCell>
        <mxCell id="c19" value="Legend: blue = application container; green = person or data-store container (type shown); grey = external system.&#10;Dashed outline = system boundary; arrows = requests/dependencies, with response data included in the label. HTTPS = encrypted HTTP." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f0f2f5;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=20;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
