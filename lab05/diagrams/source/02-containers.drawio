        <mxCell id="c5" value="University Student&#10;[Person using a browser]&#10;HTML forms over HTTPS;&#10;no separate browser app." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e4f4ed;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="420" width="320" height="210" />
        </mxCell>
        <mxCell id="c6" value="Board Web App&#10;[Container: Node.js + TypeScript + Express]&#10;Server-rendered HTML; authentication and owner checks;&#10;workshop creation, publishing, reads and reservations;&#10;one process with internal components;&#10;requests confirmation only after committing a new seat." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=24;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="550" y="340" width="740" height="265" />
        </mxCell>
        <mxCell id="c7" value="Board Database&#10;[Container: PostgreSQL on persistent storage]&#10;Stores workshops, ownership and reservations.&#10;Transactions, row locks and unique constraints.&#10;Authoritative state survives application/database restart." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e4f4ed;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=24;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
