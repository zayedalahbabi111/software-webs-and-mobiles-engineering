        </mxCell>
        <mxCell id="c5" value="ReservationService [class]&#10;reserve(context: AuthContext,&#10;        workshopId: WorkshopId): Promise&lt;ReserveResult&gt;&#10;Coordinates identity check, transaction,&#10;SeatPolicy decision and post-commit confirmation.&#10;Never trusts a student ID submitted in a form." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="285" width="620" height="260" />
        </mxCell>
        <mxCell id="c6" value="SeatPolicy [pure function]&#10;decide(workshop: Workshop,&#10;       existing: Reservation | null,&#10;       count: integer): Decision&#10;Existing | InsertAllowed |&#10;NotPublished | Full" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="865" y="285" width="515" height="235" />
        </mxCell>
        <mxCell id="c7" value="Domain types [immutable records / tagged unions]&#10;AuthContext = VerifiedStudent {studentId: StudentId, name: string, email: Email} | Unauthenticated&#10;Workshop = {id: WorkshopId, ownerId: StudentId, title: string, start: Timestamp, capacity: integer, published: boolean}&#10;Reservation = {id: ReservationId, workshopId: WorkshopId, studentId: StudentId, name: string, email: Email, createdAt: Timestamp}&#10;Decision = Existing(Reservation) | InsertAllowed | NotPublished | Full" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="665" width="1270" height="205" />
        </mxCell>
        <mxCell id="c8" value="Workshop Store [supporting component]&#10;TypeScript transaction interface&#10;withLockedWorkshop&lt;T&gt;(wid, fn): Promise&lt;T&gt;&#10;Tx: getWorkshopForUpdate(wid),&#10;findReservation(wid, sid), countSeats(wid),&#10;insertReservation(verifiedStudent, wid)&#10;Returns only after COMMIT succeeds." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f0f2f5;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1550" y="255" width="480" height="245" />
        </mxCell>
        <mxCell id="c9" value="Confirmation [supporting component]&#10;TypeScript interface&#10;requestOnce(reservation, workshop)&#10;-&gt; Promise&lt;Requested | Unavailable&gt;&#10;Not called for Existing or Rejected." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f0f2f5;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
