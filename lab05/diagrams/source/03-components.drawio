        </mxCell>
        <mxCell id="c2" value="Expands: Board Web App (02-containers). All blue boxes are in-process TypeScript modules, not deployed services." style="rounded=0;whiteSpace=wrap;html=0;fillColor=white;strokeColor=white;fontColor=#172b42;fontFamily=Arial;fontSize=21;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="103" width="2210" height="52" />
        </mxCell>
        <mxCell id="c3" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;spacing=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="420" width="2205" height="1245" />
        </mxCell>
        <mxCell id="c4" value="BOARD WEB APP [Container: Node.js + TypeScript + Express]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=white;strokeColor=white;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="428" width="2175" height="40" />
        </mxCell>
        <mxCell id="c5" value="Campus Identity&#10;[External software system]&#10;Verifies credentials; returns profile." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f0f2f5;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="180" width="400" height="170" />
        </mxCell>
        <mxCell id="c6" value="University Student&#10;[Person using a browser]&#10;Forms, session cookie, HTML." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e4f4ed;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="180" width="420" height="170" />
        </mxCell>
        <mxCell id="c7" value="University Mail&#10;[External software system]&#10;Accepts email or is unavailable." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f0f2f5;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1770" y="180" width="410" height="170" />
        </mxCell>
        <mxCell id="c8" value="Identity Gate&#10;[Component: TypeScript]&#10;login(credential) / require(cookie)&#10;-&gt; VerifiedStudent | Unauthenticated&#10;Checks university identity,&#10;session signature and expiry. [R1]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="475" width="420" height="235" />
        </mxCell>
        <mxCell id="c9" value="Web Routes&#10;[Component: TypeScript / Express]&#10;HTTPS forms -&gt; HTML outcomes&#10;Requires Identity Gate for every&#10;board request; passes trusted&#10;identity to use cases. [R1-R6]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="475" width="420" height="235" />
        </mxCell>
        <mxCell id="c10" value="Board Queries&#10;[Component: TypeScript]&#10;listPublished(student) -&gt; Summary[]&#10;attendees(student, wid) -&gt; Contact[]&#10;Only owner gets names/emails;&#10;other callers receive Forbidden.&#10;Summaries include only own seat. [R3]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="900" width="430" height="245" />
        </mxCell>
        <mxCell id="c11" value="Workshop Rules&#10;[Component: TypeScript]&#10;create(student, draft) -&gt; Workshop&#10;publish(student, wid) -&gt; Published&#10;Create unpublished; owner = student ID;&#10;publish only if owner matches.&#10;Publishing inserts no seat. [R2]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="900" width="430" height="245" />
        </mxCell>
        <mxCell id="c12" value="Reservation Rules&#10;[Component: TypeScript]&#10;reserve(context, wid) -&gt; ReserveResult&#10;Verify, lock, find existing seat;&#10;check publication and capacity;&#10;commit new seat before mail.&#10;Existing seat -&gt; no mail. [R4, R6]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1730" y="900" width="430" height="245" />
        </mxCell>
        <mxCell id="c13" value="Workshop Store&#10;[Component: TypeScript / PostgreSQL driver]&#10;Parameterized SQL; withLockedWorkshop(wid, callback);&#10;create / publishOwned / listPublished / ownerAndAttendees.&#10;Owns transactions, workshop locks and persistence.&#10;Returns stored workshop/reservation records. [R2-R5]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="1380" width="660" height="235" />
        </mxCell>
        <mxCell id="c14" value="Confirmation&#10;[Component: TypeScript / HTTPS client]&#10;requestOnce(reservation, workshop)&#10;-&gt; Requested | Unavailable&#10;One attempt after commit;&#10;no rollback or automatic retry. [R6]" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e8f1fc;strokeColor=#506176;fontColor=#172b42;fontFamily=Arial;fontSize=21;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1730" y="1380" width="430" height="200" />
        </mxCell>
